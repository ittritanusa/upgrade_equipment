APP_NAME=FMS-LRVL
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-fms-laravel.tirtanusa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=db_trucking_system
DB_USERNAME=fms
DB_PASSWORD=fms_secret
STAGING_DB_ROOT_PASSWORD=rootpassword
MYSQL_CLIENT_IMAGE=mariadb:10.6

# Set true if staging should connect directly to production DB on server 155
USE_PRODUCTION_DB_DIRECT=false
SKIP_DB_BOOTSTRAP=true
CLONE_SOURCE_DB_FULL=true
FORCE_CLONE_SOURCE_DB=false

ERP_DB_HOST=host.docker.internal
ERP_DB_PORT=3311
ERP_DB_DATABASE=tirtalogisticco_erp
ERP_DB_USERNAME=tirtanusa2025
ERP_DB_PASSWORD=change_me

SOURCE_DB_HOST=host.docker.internal
SOURCE_DB_PORT=3306
SOURCE_DB_DATABASE=db_trucking_system
SOURCE_DB_USERNAME=it
SOURCE_DB_PASSWORD=change_me
SYNC_SOURCE_M_USER=false
FORCE_SYNC_M_USER=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tirtanusa.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# If USE_PRODUCTION_DB_DIRECT=true, recommended overrides:
# DB_HOST=host.docker.internal
# DB_PORT=3306
# DB_DATABASE=db_trucking_system
# DB_USERNAME=it
# DB_PASSWORD=change_me
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# SYNC_SOURCE_M_USER=false
# SKIP_DB_BOOTSTRAP=true

# If you prefer a dedicated staging DB cloned from production:
# CLONE_SOURCE_DB_FULL=true
# FORCE_CLONE_SOURCE_DB=false
# USE_PRODUCTION_DB_DIRECT=false
# DB_HOST=mariadb
# DB_PORT=3306
# DB_DATABASE=db_trucking_system
# DB_USERNAME=fms
# DB_PASSWORD=fms_secret
#
# Then run:
# ./docker/staging/clone-production-db.sh
#
# Recommended for "no migration" mode after full clone:
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# SYNC_SOURCE_M_USER=false
# SKIP_DB_BOOTSTRAP=true
